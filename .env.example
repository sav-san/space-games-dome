DOME_URL=
DOME_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_LOG_DIR=logs
AGENT_STATE_DIR=state
AGENT_ANALYSIS_INTERVAL=60
AGENT_LLM_TIMEOUT=60
AGENT_STALE_SECONDS=20
# disabled (по умолчанию) отключает thinking у DeepSeek V4; default — не передавать параметр
DEEPSEEK_THINKING=disabled

# true: ограниченные самостоятельные действия; false: только рекомендации
AGENT_AUTONOMY=true

# Предлагать решения и планы на подтверждение в GUI
AGENT_PROPOSALS=true
